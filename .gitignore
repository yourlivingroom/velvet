# Dependencies
node_modules/

# Built client (Vite output) — regenerated by `npm run build:client`.
client/dist/

# Runtime data — pulp-db collections, signing key, bootstrap secrets.
# Never commit: data/keys/ holds the JWT signing key and data/.bootstrap-code
# is a live admin credential.
data/

# Logs / debug output
*.log
npm-debug.log*

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
